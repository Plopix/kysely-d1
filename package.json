{
  "name": "@notsplol/kysely-d1",
  "description": "Kysely dialect for Cloudflare D1",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "version": "0.4.0",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/notsplol/kysely-d1.git"
  },
  "author": "Shivam Patel <shivam.patel.nvim@gmail.com>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kysely",
    "cloudflare",
    "d1",
    "workers",
    "serverless"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && mv dist/cjs/index.js dist/index.cjs && rmdir dist/cjs",
    "check": "prettier --check src/ example/",
    "format": "prettier --write src/ example/"
  },
  "peerDependencies": {
    "kysely": ">=0.27.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260608.1",
    "kysely": "^0.29.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}